{
  "name": "@hzttt/lucy-ai-npc",
  "version": "2026.4.25",
  "description": "OpenClaw Lucy NATS DM channel plugin (AI NPC variant)",
  "type": "module",
  "main": "./index.ts",
  "scripts": {
    "auth-qrcode": "tsx ./scripts/auth-qrcode.ts",
    "test:unit": "vitest run src/*.test.ts",
    "test:presence": "tsx --test src/presence.test.ts",
    "test:e2e:bind": "node test/e2e/01-bind-flow.mjs",
    "test:e2e:msg": "node test/e2e/02-messaging.mjs",
    "test:e2e:media": "node test/e2e/03-media.mjs",
    "test:e2e": "npm run test:e2e:msg && npm run test:e2e:media",
    "typecheck": "tsc --project tsconfig.json"
  },
  "files": [
    "README.md",
    "index.ts",
    "openclaw.plugin.json",
    "src",
    "lucy-im-sdk/dist",
    "lucy-im-sdk/package.json",
    "lucy-im-sdk/README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hzttt/lucy-blob-node-native": "^0.3.0",
    "lucy-im-sdk": "file:./lucy-im-sdk",
    "nats": "^2.29.3",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/qrcode-terminal": "^0.12.2",
    "openclaw": "*",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "lucy",
      "label": "Lucy",
      "selectionLabel": "Lucy AI NPC (NATS DM)",
      "docsPath": "/channels/lucy",
      "docsLabel": "lucy",
      "blurb": "DM-only chat over NATS subjects scoped by channel_user_key and channel_device_id.",
      "order": 95
    },
    "install": {
      "npmSpec": "@hzttt/lucy-ai-npc",
      "localPath": "extensions/lucy",
      "defaultChoice": "npm"
    }
  }
}
