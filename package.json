{
  "name": "@hzttt/lucy",
  "version": "2026.3.24",
  "description": "OpenClaw Lucy NATS DM channel plugin",
  "type": "module",
  "main": "./index.ts",
  "scripts": {
    "auth-qrcode": "tsx ./scripts/auth-qrcode.ts"
  },
  "files": [
    "README.md",
    "index.ts",
    "openclaw.plugin.json",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "nats": "^2.29.3",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "openclaw": "*",
    "tsx": "^4.20.6"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "lucy",
      "label": "Lucy",
      "selectionLabel": "Lucy (NATS DM)",
      "docsPath": "/channels/lucy",
      "docsLabel": "lucy",
      "blurb": "DM-only chat over NATS subjects scoped by channel_user_key and channel_device_id.",
      "order": 95
    },
    "install": {
      "npmSpec": "@hzttt/lucy",
      "localPath": "extensions/lucy",
      "defaultChoice": "npm"
    }
  }
}
